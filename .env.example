# Local synthetic development: never place live credentials in this mode.
APP_MODE=demo
HOST=127.0.0.1
PORT=8787
DATA_DIR=.data

# Public Firebase browser configuration, used only for configured live sign-in.
# These are separate from backend credentials. Restrict Firebase authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAP_ID=
VITE_TURNSTILE_SITE_KEY=

# Server configuration, required only after the live integration gates are closed.
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
GCS_BUCKET=
TASKS_LOCATION=
TASKS_QUEUE=
WORKER_URL=
TASKS_SERVICE_ACCOUNT_EMAIL=

# Managed secret names are shown here without example secret values.
# Inject different secrets into each environment. Do not expose through VITE_*.
EDGE_ORIGIN_SECRET=
EVIDENCE_HMAC_KEY=
GOOGLE_MAPS_SERVER_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=
POLICY_CONFIG_PATH=
PROVIDER_CONFIG_PATH=

# Live sources, route storage/export permission and entitlement policy stay disabled.
# See docs/gates.md; setting a key alone does not grant permission or enable the app.
